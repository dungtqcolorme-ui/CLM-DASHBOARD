NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=https://clm-dashboard-eosin.vercel.app
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://clm-dashboard-eosin.vercel.app/api/google/calendar/oauth/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=generate-a-long-random-server-only-secret
GOOGLE_CALENDAR_ID=primary
# Server-only secret used by Vercel Cron or another trusted scheduler.
# Leave unset to keep the email dispatcher disabled safely.
CRON_SECRET=generate-a-long-random-server-only-secret


# Optional Studio bridge for one existing Codex chat. Server-side only.
CLM_CODEX_OWNER_ID=
CLM_CODEX_BRIDGE_TOKEN=
# Set these on the computer that runs scripts/studio-codex-bridge.mjs.
CLM_CODEX_WEB_URL=
CLM_CODEX_THREAD_ID=
